{
	# Let's Encrypt account contact (certificate expiry notices).
	email info@michisuu.com
}

grc.michisuu.com {
	# Access log as JSON on stdout -> CloudWatch Logs (/opengrc/containers).
	log {
		output stdout
		format json
	}
	encode zstd gzip
	# probod already sends HSTS, CSP, X-Frame-Options, nosniff,
	# Referrer-Policy and Permissions-Policy; only hide server details.
	header {
		-Server
		-Via
		defer
	}
	reverse_proxy probo:8080
}

# probod always exports OpenTelemetry traces (there is no switch to turn
# them off). Accept and discard them on the internal network so they do
# not fill the logs with export errors. Port 4318 is not published.
http://:4318 {
	respond 200
}
